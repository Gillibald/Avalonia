<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TextTestApp"
    x:Class="TextTestApp.MainWindow"
    Title="Text Test App" Width="1500" Height="950">

    <DockPanel>
      <!-- Context bar: the app-global inputs every view reads, plus the scope capsule
           that says which of them the active view honors. -->
      <DockPanel DockPanel.Dock="Top" Margin="5">
        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Click="OnNewWindowClick"
                ToolTip.Tip="Open another window for side-by-side comparisons" Margin="5,0,0,0">+</Button>
        <ComboBox DockPanel.Dock="Right" Name="_rasterBox" Width="110" VerticalAlignment="Center"
                  ToolTip.Tip="App-wide TextRasterizationMode: Managed is Avalonia's own rasterizer, Backend is the render backend's text stack (SKTextBlob on Skia)." />
        <Label DockPanel.Dock="Right" Content="_Raster:" Target="{Binding ElementName=_rasterBox}"
               VerticalAlignment="Center" Margin="10,0,0,0" />
        <TextBox DockPanel.Dock="Right" Name="_size" VerticalAlignment="Center" Text="64" MinWidth="50" />
        <Label DockPanel.Dock="Right" Content="_Size:" Target="{Binding ElementName=_size}"
               VerticalAlignment="Center" Margin="5,0,0,0" />
        <Label Content="_Font:" Target="{Binding ElementName=_font}" VerticalAlignment="Center" />
        <AutoCompleteBox Name="_font" Width="380" HorizontalAlignment="Left" VerticalAlignment="Center"
                         PlaceholderText="type to search fonts" FilterMode="Contains" MinimumPrefixLength="0"
                         MaxDropDownHeight="480"
                         ItemsSource="{Binding SystemFonts, Source={x:Static FontManager.Current}}"
                         ValueMemberBinding="{Binding Name, x:DataType=FontFamily}" />
        <TextBlock Name="_scopeText" VerticalAlignment="Center" Margin="14,0,8,0" FontSize="11"
                   Opacity="0.65" TextTrimming="CharacterEllipsis" />
      </DockPanel>

      <!-- Sidebar navigation: sections mirror the audit IA; more sections arrive with
           their views (Showcase, Font info, Variable fonts, Learn). -->
      <Border DockPanel.Dock="Left" BorderBrush="#30808080" BorderThickness="0,1,1,0" Background="#08808080">
        <ListBox Name="_nav" Width="150" Background="Transparent">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="12,7" />
            </Style>
            <Style Selector="ListBoxItem.section">
              <Setter Property="IsEnabled" Value="False" />
              <Setter Property="FontSize" Value="11" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="Padding" Value="12,12,12,2" />
            </Style>
          </ListBox.Styles>
          <ListBoxItem Classes="section" Content="EXPLORE" />
          <ListBoxItem Name="NavGlyphs" Content="Glyphs" />
          <ListBoxItem Classes="section" Content="DIAGNOSE" />
          <ListBoxItem Name="NavWaterfall" Content="Waterfall" />
          <ListBoxItem Name="NavFringes" Content="Fringes" />
          <ListBoxItem Name="NavAbDiff" Content="A/B diff" />
          <ListBoxItem Name="NavHitTesting" Content="Hit testing" />
        </ListBox>
      </Border>

      <Panel>
        <!-- Glyphs: the explorer with its two drill-in inspectors (mono pipeline,
             color altitude) - Back or Escape returns to the grid. -->
        <Panel Name="_glyphsHost">
          <local:GlyphExplorerView Name="_explorer" />
          <local:RasterizationView Name="_raster" IsVisible="False" />
          <local:ColorGlyphInspectorView Name="_colorInspector" IsVisible="False" />
        </Panel>

        <local:WaterfallView Name="_waterfall" IsVisible="False" />
        <local:FringesView Name="_fringes" IsVisible="False" />
        <local:AbDiffView Name="_abDiff" IsVisible="False" />

        <DockPanel Name="_hitTesting" IsVisible="False">
          <DockPanel DockPanel.Dock="Top" Margin="5">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Label Content="Fea_tures:" Target="{Binding ElementName=_features}" VerticalAlignment="Center" Margin="5,0,0,0" />
              <TextBox Name="_features" VerticalAlignment="Center" Text="calt clig kern liga" />
            </StackPanel>
            <Label Content="_Text:" Target="{Binding ElementName=_text}" VerticalAlignment="Center" />
            <TextBox Name="_text" Text="Hello!" VerticalAlignment="Center" />
          </DockPanel>

          <Border DockPanel.Dock="Bottom" Background="WhiteSmoke" BorderThickness="0,1,0,0" BorderBrush="Silver" Padding="2">
            <DockPanel>
              <ToggleSwitch Name="_hitRangeToggle" DockPanel.Dock="Right" OnContent="Range" OffContent="Position"
                            IsCheckedChanged="OnHitTestMethodChanged"
                            ToolTip.Tip="Method behind the readout and row selection: on = TextLayout.HitTestTextRange over the selected rows, off = TextLayout.HitTestTextPosition for a single index." />
              <TextBlock DockPanel.Dock="Right" Text="Hit test:" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Pointer:" Margin="5,0"
                           ToolTip.Tip="Pointer position over the line in layout coordinates - the input to TextLayout.HitTestPoint." />
                <TextBlock Name="_coordinates" MinWidth="120" />
                <Border Width="5" BorderThickness="1,0,0,0" BorderBrush="Silver" UseLayoutRounding="True" Margin="5,0,0,0" />
                <TextBlock Text="Text position:" Margin="5,0"
                           ToolTip.Tip="TextHitTestResult of HitTestPoint: text position, then character hit as index+trailing; T marks a trailing-edge hit." />
                <TextBlock Name="_hit" MinWidth="60" />
                <Border Width="5" BorderThickness="1,0,0,0" BorderBrush="Silver" UseLayoutRounding="True" Margin="5,0,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>

          <Grid RowDefinitions="*,5,*">
            <local:InteractiveLineControl Name="_rendering" Margin="16" HorizontalAlignment="Center"

                                          Text="{Binding Text, ElementName=_text}"
                                          FontFamily="{Binding SelectedItem, ElementName=_font}"
                                          FontFeatures="{Binding Text, ElementName=_features}"
                                          FontSize="{Binding Text, ElementName=_size}"
                                          Background="BlanchedAlmond"
                                          ExtentStroke="Black"
                                          BaselineStroke="Blue"
                                          TextBoundsStroke="Goldenrod"
                                          RunBoundsStroke="Gold"
                                          NextHitStroke="Green"
                                          PreviousHitStroke="Blue"
                                          BackspaceHitStroke="Red"
                                          DistanceStroke="Black"

                                          PointerMoved="OnPointerMoved"
              />

            <GridSplitter Grid.Row="1" />

            <TabControl Name="_tabs" Grid.Row="2" Background="White" BorderBrush="Whitesmoke" BorderThickness="0,1,0,0">
              <TabItem Header="Shaped Buffer">
                <ListBox Name="_buffer" Grid.IsSharedSizeScope="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionMode="Multiple" SelectionChanged="OnBufferSelectionChanged" Background="Transparent">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Background" Value="White" />
                    </Style>
                  </ListBox.Styles>
                  <Border Background="WhiteSmoke" BorderBrush="Silver" BorderThickness="0,1">
                    <local:GridRow ColumnSpacing="10">
                      <TextBlock Text="" />
                      <TextBlock Text="Index" />
                      <TextBlock Text="Characters" />
                      <TextBlock Text="Codepoints" />
                      <TextBlock Text="Glyph" />
                      <TextBlock Text="Glyph ID" />
                      <TextBlock Text="Advance" />
                      <TextBlock Text="Offset" />
                      <TextBlock Text="Ink Bounds" />
                    </local:GridRow>
                  </Border>
                </ListBox>
              </TabItem>
              <TabItem Header="Character Hits">
                <ListBox Name="_hits" Grid.IsSharedSizeScope="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="OnHitsSelectionChanged" Background="Transparent">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Background" Value="White" />
                    </Style>
                  </ListBox.Styles>
                  <Border Background="WhiteSmoke" BorderBrush="Silver" BorderThickness="0,1">
                    <local:GridRow ColumnSpacing="10">
                      <TextBlock Text="" />
                      <TextBlock Text="Backspace Hit" />
                      <TextBlock Text="Previous Hit" />
                      <TextBlock Text="Index" />
                      <TextBlock Text="Next Hit" />
                      <TextBlock Text="Codepoint" />
                      <TextBlock Text="Character" />
                      <TextBlock Text="Distance" />
                    </local:GridRow>
                  </Border>
                </ListBox>
              </TabItem>
            </TabControl>
          </Grid>
        </DockPanel>
      </Panel>
    </DockPanel>
</Window>

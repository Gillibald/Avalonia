<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TextTestApp.RasterizationView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#18808080" Padding="10,6">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock x:Name="GlyphText" VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="230"
                   Text="select a glyph in the explorer" />
        <TextBlock Text="Hinting" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        <ComboBox x:Name="HintingBox" Width="100" />
        <CheckBox x:Name="GammaBox" Content="Gamma" IsChecked="True" />
        <CheckBox x:Name="BgrBox" Content="BGR" />
        <CheckBox x:Name="TintTiersBox" Content="Tint tiers" />
      </StackPanel>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="12" Spacing="6">
        <TextBlock Text="1. Hinting — zones, stroke pairs, and the warp" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Opacity="0.7" FontSize="12"
                   Text="Drag the size slider and watch the cap and ascender rows merge and split; the blue outline is what actually rasterizes." />
        <Image x:Name="HintingImage" Stretch="None" HorizontalAlignment="Left" />

        <TextBlock Text="2. Masks — the cached unit and the composed run" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0" />
        <Image x:Name="MaskImage" Stretch="None" HorizontalAlignment="Left" />

        <TextBlock Text="3. ClearType — 3x raster, stripe channels, composite" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0" />
        <Image x:Name="LcdImage" Stretch="None" HorizontalAlignment="Left" />

        <TextBlock Text="4. Slug payload — em-space curves and the band partition the shader walks" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0" />
        <Image x:Name="SlugImage" Stretch="None" HorizontalAlignment="Left" />

        <TextBlock Text="5. Tier routing (live rendering of this window)" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0" />
        <TextBlock Opacity="0.7" FontSize="12"
                   Text="Check 'Tint tiers' above: every run gets a badge from the tier that drew it — green run masks, magenta Slug vector tier, orange native blob. Managed tiers engage when the app runs with TextRasterizationMode.Managed." />
        <ContentControl x:Name="TierSampleHost" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>

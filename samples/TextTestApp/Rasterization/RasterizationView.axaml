<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TextTestApp.RasterizationView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#18808080" Padding="10,6">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button x:Name="BackButton" Content="&#x2190; Back" ToolTip.Tip="Back to the glyph grid (Esc)" />
        <TextBlock x:Name="GlyphText" VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="230"
                   Text="select a glyph in the explorer" />
        <TextBlock Text="Hinting" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        <ComboBox x:Name="HintingBox" Width="100" AutomationProperties.Name="Hinting mode" />
        <CheckBox x:Name="GammaBox" Content="Gamma" IsChecked="True"
                  ToolTip.Tip="Apply the gamma/contrast coverage correction to the composite panel." />
        <CheckBox x:Name="BgrBox" Content="BGR"
                  ToolTip.Tip="Compose for blue-green-red subpixel stripe order instead of RGB." />
        <CheckBox x:Name="TintTiersBox" Content="Tint tiers"
                  ToolTip.Tip="Badges every run in the window by the tier that drew it: green run masks, magenta Slug, orange native blob." />
        <Button x:Name="CopyButton" Content="Copy details" FontSize="12"
                ToolTip.Tip="Copy the glyph, engine, mask key and Slug payload details as text." />
      </StackPanel>
    </Border>
    <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
      <DockPanel Grid.Row="0" Grid.Column="0" Margin="8,4,4,4">
        <TextBlock DockPanel.Dock="Top" x:Name="HintingTitle" Text="Hinting" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" x:Name="EngineText" FontSize="12" Opacity="0.75" Margin="0,2,0,2" />
        <DockPanel DockPanel.Dock="Top" x:Name="ScrubRow" Margin="0,0,8,2" IsVisible="False">
          <TextBlock DockPanel.Dock="Right" x:Name="StepText" FontSize="12" FontFamily="Consolas,monospace"
                     VerticalAlignment="Center" MinWidth="230" Margin="8,0,0,0" />
          <Slider x:Name="StepSlider" Minimum="0" IsSnapToTickEnabled="True" TickFrequency="1"
                  AutomationProperties.Name="Instruction step"
                  ToolTip.Tip="Scrub through the glyph program: each position is the outline after one more instruction." />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="HintLegendText" FontSize="11" Opacity="0.7"
                   TextWrapping="Wrap" Margin="0,0,8,4" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
          <Image x:Name="HintingImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
      </DockPanel>
      <DockPanel Grid.Row="0" Grid.Column="1" Margin="4,4,8,4">
        <TextBlock DockPanel.Dock="Top" Text="Masks — the cached unit and the composed run" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" x:Name="MaskInfoText" FontSize="11" Opacity="0.7"
                   TextWrapping="Wrap" Margin="0,2,8,4" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
          <Image x:Name="MaskImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
      </DockPanel>
      <DockPanel Grid.Row="1" Grid.Column="0" Margin="8,4,4,8">
        <TextBlock DockPanel.Dock="Top" Text="ClearType — 3x raster, stripe channels, composite" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" x:Name="LcdLegendText" FontSize="11" Opacity="0.7"
                   TextWrapping="Wrap" Margin="0,2,8,4" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
          <Image x:Name="LcdImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
      </DockPanel>
      <DockPanel Grid.Row="1" Grid.Column="1" Margin="4,4,8,8">
        <TextBlock DockPanel.Dock="Top" Text="Slug payload — em-space curves and bands" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" x:Name="SlugInfoText" FontSize="11" Opacity="0.7"
                   TextWrapping="Wrap" Margin="0,2,8,4" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
          <Image x:Name="SlugImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TextTestApp.ColorGlyphsView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#18808080" Padding="10,6">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Size" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        <ComboBox x:Name="SizeBox" Width="80" />
        <TextBlock x:Name="PaletteLabel" Text="Palette" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        <ComboBox x:Name="PaletteBox" Width="110" />
        <TextBox x:Name="SearchBox" Width="170" PlaceholderText="find: A, U+1F600, #685"
                 ToolTip.Tip="Search: a character, U+1F600, or a glyph id like #685. Enter jumps to the match; digits mean glyph id." />
        <Button x:Name="PrevButton" Content="&lt;" />
        <TextBox x:Name="PageBox" Width="44" TextAlignment="Center"
                 ToolTip.Tip="Page number - type one and press Enter." />
        <TextBlock x:Name="PageCountText" VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="40" />
        <Button x:Name="NextButton" Content="&gt;" />
        <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
      </StackPanel>
    </Border>
    <Panel>
      <Grid ColumnDefinitions="Auto,300">
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto">
          <Image x:Name="GridImage" Stretch="None" VerticalAlignment="Top" HorizontalAlignment="Left"
                 Margin="8" />
        </ScrollViewer>
        <Border Grid.Column="1" Padding="12" BorderBrush="#30808080" BorderThickness="1,0,0,0">
          <ScrollViewer>
            <StackPanel Spacing="4">
              <TextBlock Text="Selection" FontWeight="SemiBold" FontSize="14" />
              <TextBlock x:Name="InfoText" FontSize="12" TextWrapping="Wrap" />
              <Image x:Name="PreviewImage" Stretch="None" HorizontalAlignment="Left" Margin="0,6,0,0" />
              <Button x:Name="InspectButton" Content="Inspect glyph" FontSize="12" IsVisible="False" />
              <TextBlock x:Name="LayersHeader" Text="COLR v0 layers" FontWeight="SemiBold" FontSize="14"
                         Margin="0,10,0,0" IsVisible="False" />
              <Image x:Name="LayersImage" Stretch="None" HorizontalAlignment="Left" />
              <TextBlock x:Name="LayersText" FontSize="11" TextWrapping="Wrap" Opacity="0.85" />
              <TextBlock Opacity="0.7" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"
                         Text="Every glyph with a color representation (COLR v0 layers, COLR v1 paint graph, or a bitmap strike), rendered through the same IGlyphDrawing path the renderer uses when it splits color glyphs out of a run. The palette selector drives CPAL resolution; the size selector picks the bitmap strike and preview scale." />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
      <Border x:Name="EmptyPanel" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="24,18" BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Background="#08808080">
        <StackPanel Spacing="10" MaxWidth="420">
          <TextBlock x:Name="EmptyText" TextWrapping="Wrap"
                     Text="This font has no color glyphs." />
          <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                     Text="Color views need a font with COLR layers or paint graphs, or embedded bitmap strikes." />
          <Button x:Name="SuggestFontButton" Content="Switch to Segoe UI Emoji" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </Panel>
  </DockPanel>
</UserControl>

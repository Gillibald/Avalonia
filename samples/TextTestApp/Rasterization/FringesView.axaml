<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TextTestApp.FringesView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#18808080" Padding="10,6">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Sample" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        <TextBox x:Name="SampleBox" Width="280" Text="Hamburgefonstiv fi ffl" />
        <TextBlock Text="Hinting" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        <ComboBox x:Name="HintingBox" Width="100" />
        <TextBlock Text="Zoom" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        <ComboBox x:Name="ZoomBox" Width="70" />
        <TextBlock x:Name="FontText" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        <Button x:Name="CopyButton" Content="Copy stats" FontSize="12"
                ToolTip.Tip="Copy the fringe counts and verdict as text." />
      </StackPanel>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Auto">
      <StackPanel Margin="10" Spacing="8">
        <TextBlock x:Name="StatsText" FontWeight="SemiBold" />
        <Image x:Name="ResultImage" Stretch="None" HorizontalAlignment="Left" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TextTestApp.GlyphExplorerView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#18808080" Padding="10,6">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Filter" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        <ComboBox x:Name="FilterBox" Width="140" />
        <TextBox x:Name="SearchBox" Width="170" PlaceholderText="find: A, U+0048, #43"
                 ToolTip.Tip="Search: a character, U+0048, or a glyph id like #43. Enter jumps to the match; digits mean glyph id, so search U+0038 for the character 8." />
        <Button x:Name="PrevButton" Content="&lt;" />
        <TextBox x:Name="PageBox" Width="44" TextAlignment="Center"
                 ToolTip.Tip="Page number - type one and press Enter." />
        <TextBlock x:Name="PageCountText" VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="40" />
        <Button x:Name="NextButton" Content="&gt;" />
        <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
      </StackPanel>
    </Border>
    <Grid ColumnDefinitions="Auto,260">
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto">
        <Image x:Name="GridImage" Stretch="None" VerticalAlignment="Top" HorizontalAlignment="Left"
               Margin="8" />
      </ScrollViewer>
      <Border Grid.Column="1" Padding="12" BorderBrush="#30808080" BorderThickness="1,0,0,0">
        <ScrollViewer>
          <StackPanel Spacing="4">
            <TextBlock Text="Line metrics" FontWeight="SemiBold" FontSize="14" />
            <TextBlock x:Name="MetricsText" FontSize="11" TextWrapping="Wrap" Opacity="0.85" />
            <TextBlock Text="Selection" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0" />
            <TextBlock x:Name="InfoText" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Opacity="0.7" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"
                       Text="Monochrome cells render through the real mask tier; color glyphs render their color drawing. Badges: magenta = COLR color glyph, orange = bitmap strike, red frame = no outline. Clicking a cell shows it in the inspector beside." />
            <TextBlock Text="Pipeline" FontWeight="SemiBold" FontSize="14" Margin="0,14,0,0" />
            <CheckBox x:Name="CountTiersBox" Content="Count tier draws" FontSize="12" />
            <TextBlock x:Name="HudText" FontSize="11" TextWrapping="Wrap" Opacity="0.85" />
            <Button x:Name="ResetCountersButton" Content="Reset counters" FontSize="12" />
            <TextBlock Text="Docs" FontWeight="SemiBold" FontSize="14" Margin="0,14,0,0" />
            <Button x:Name="ExportFiguresButton" Content="Export doc figures..." FontSize="12"
                    ToolTip.Tip="Writes the deterministic Inter pipeline figures embedded in docs/glyph-rasterization. Falls back to the current font if the repo asset is missing." />
            <TextBlock x:Name="ExportStatusText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TextLab.FontInfoView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#18808080" Padding="10,6">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontWeight="SemiBold" />
        <Button x:Name="CopyButton" Content="Copy report" FontSize="12"
                ToolTip.Tip="Copy everything on this page as text." />
      </StackPanel>
    </Border>
    <Grid ColumnDefinitions="*,*" Margin="16,12">
      <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,24,0">
        <TextBlock Text="Identity" FontWeight="SemiBold" FontSize="14" />
        <TextBlock x:Name="IdentityText" FontSize="12" TextWrapping="Wrap" />
        <TextBlock Text="Metrics" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0" />
        <TextBlock x:Name="MetricsText" FontSize="12" TextWrapping="Wrap"
                   FontFamily="Consolas,Courier New,monospace" />
        <TextBlock Text="Coverage" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0" />
        <TextBlock x:Name="CoverageText" FontSize="12" TextWrapping="Wrap" />
        <TextBlock Text="Variation" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0" />
        <TextBlock x:Name="VariationText" FontSize="12" TextWrapping="Wrap" />
        <Button x:Name="ExploreAxesButton" Content="Explore the axes" FontSize="12"
                IsVisible="False" Margin="0,4,0,0" />
        <TextBlock Text="Color" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0" />
        <TextBlock x:Name="ColorText" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
      <!-- A font carries as many tables, features and licence text as it likes. -->
      <ScrollViewer Grid.Column="1" Classes="data">
        <StackPanel Spacing="4">
          <TextBlock Text="Tables" FontWeight="SemiBold" FontSize="14" />
          <TextBlock x:Name="TablesText" FontSize="12" TextWrapping="Wrap"
                     FontFamily="Consolas,Courier New,monospace" />
          <TextBlock Text="OpenType features" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0" />
          <TextBlock x:Name="FeaturesText" FontSize="12" TextWrapping="Wrap"
                     FontFamily="Consolas,Courier New,monospace" />
          <TextBlock Text="Legal" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0" />
          <TextBlock x:Name="LegalText" FontSize="12" TextWrapping="Wrap" Opacity="0.85" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>

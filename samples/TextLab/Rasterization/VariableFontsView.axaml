<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TextLab.VariableFontsView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#18808080" Padding="10,6">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Sample" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        <TextBox x:Name="SampleBox" Width="260" Text="Handgloves 0123" AutomationProperties.Name="Sample text" />
        <TextBlock Text="Ladder axis" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        <ComboBox x:Name="LadderAxisBox" Width="150" AutomationProperties.Name="Ladder axis" />
        <Button x:Name="CopyButton" Content="Copy coordinates" FontSize="12"
                ToolTip.Tip="Copy the axis values, normalized coordinates and instance match as text." />
        <TextBlock x:Name="FontText" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
      </StackPanel>
    </Border>
    <Panel>
      <Grid ColumnDefinitions="330,*">
        <Border Grid.Column="0" BorderBrush="#30808080" BorderThickness="0,0,1,0">
          <!-- A font declares as many axes as it likes, so the axis list may scroll. -->
          <ScrollViewer Classes="data">
            <StackPanel Margin="12" Spacing="6">
              <TextBlock Text="Axes" FontWeight="SemiBold" FontSize="14" />
              <StackPanel x:Name="AxesPanel" Spacing="8" />
              <Button x:Name="ResetButton" Content="Reset to defaults" FontSize="12" Margin="0,4,0,0" />
              <TextBlock Text="Named instance" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0" />
              <ComboBox x:Name="InstanceBox" HorizontalAlignment="Stretch" PlaceholderText="none declared"
                        AutomationProperties.Name="Named instance" />
              <TextBlock Text="Current coordinates" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0" />
              <TextBlock x:Name="CoordsText" FontFamily="Consolas,Courier New,monospace" FontSize="12"
                         TextWrapping="Wrap"
                         ToolTip.Tip="user value -> normalized [-1..1]. '(avar)' marks axes the font's avar table remaps away from the linear fvar normalization." />
              <TextBlock x:Name="MatchText" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </Border>
        <Grid Grid.Column="1" ColumnDefinitions="*,*" Margin="12">
          <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="Specimen" FontWeight="SemiBold" FontSize="14" />
            <Image DockPanel.Dock="Top" x:Name="SpecimenImage" Stretch="Uniform" StretchDirection="DownOnly"
                   RenderOptions.BitmapInterpolationMode="HighQuality" HorizontalAlignment="Left" Margin="0,6,0,0" />
            <TextBlock DockPanel.Dock="Top" Text="Property pipeline" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0" />
            <TextBlock DockPanel.Dock="Top" Text="The same axis values applied through TextElement.FontVariations: a live TextBlock rendered by the normal text pipeline, not a raster image. Slider changes animate through FontVariationSettingsTransition - matching axis sets interpolate per axis."
                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock DockPanel.Dock="Top" x:Name="PropertyBlock" HorizontalAlignment="Left" TextWrapping="Wrap" />
            <TextBlock DockPanel.Dock="Top" Text="Diagnostics" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0" />
            <TextBlock DockPanel.Dock="Top" x:Name="EngineText" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
            <TextBlock DockPanel.Dock="Top" x:Name="CacheText" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
            <Panel />
          </DockPanel>
          <Grid Grid.Column="1" RowDefinitions="Auto,Auto,2*,Auto,*">
            <TextBlock x:Name="LadderTitle" Text="Interpolation ladder" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Grid.Row="1" Text="One axis swept min to max while the others hold their current values - kinks or stem collapses between rows are interpolation defects."
                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
            <Image Grid.Row="2" x:Name="LadderImage" Stretch="Uniform" StretchDirection="DownOnly"
                   RenderOptions.BitmapInterpolationMode="HighQuality" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0" />
            <TextBlock Grid.Row="3" x:Name="OverlayTitle" Text="Outline overlay" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,0" />
            <Image Grid.Row="4" x:Name="OverlayImage" Stretch="Uniform" StretchDirection="DownOnly"
                   RenderOptions.BitmapInterpolationMode="HighQuality" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0" />
          </Grid>
        </Grid>
      </Grid>
      <Border x:Name="EmptyPanel" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="24,18" BorderBrush="#40808080" BorderThickness="1" CornerRadius="4" Background="#18808080">
        <StackPanel Spacing="10" MaxWidth="440">
          <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Text="This font has no variation axes." />
          <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                     Text="Variable fonts declare design axes in an fvar table (weight, width, optical size). Pick an installed variable font to explore its space." />
          <StackPanel x:Name="SuggestPanel" Orientation="Horizontal" Spacing="8" />
        </StackPanel>
      </Border>
    </Panel>
  </DockPanel>
</UserControl>

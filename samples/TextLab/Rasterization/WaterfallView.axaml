<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TextLab.WaterfallView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#18808080" Padding="10,6">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Sample" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        <TextBox x:Name="SampleBox" Width="320" Text="Hamburgefonstiv Base8S 123" AutomationProperties.Name="Sample text" />
        <TextBlock Text="Rendering" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        <ComboBox x:Name="RenderingBox" Width="160" AutomationProperties.Name="Rendering mode" />
        <TextBlock Text="Zoom" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
        <ComboBox x:Name="ZoomBox" Width="80" AutomationProperties.Name="Zoom"
                  ToolTip.Tip="Device pixels per rendered pixel. Fit picks the largest that fits the page." />
        <TextBlock x:Name="FontText" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
      </StackPanel>
    </Border>
    <Panel x:Name="MatrixHost" Margin="10">
      <Image x:Name="MatrixImage" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapInterpolationMode="HighQuality" HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Panel>
  </DockPanel>
</UserControl>

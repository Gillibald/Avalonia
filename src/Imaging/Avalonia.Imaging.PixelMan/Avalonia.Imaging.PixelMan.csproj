<Project Sdk="Microsoft.NET.Sdk">
  <!--
    PixelMan ships on the internal Avalonia feed only (see NuGet.config next to this file),
    so this project is not part of the solution yet: it restores only where that feed's
    credentials are available.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(AvsCurrentTargetFramework);$(AvsLegacyTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Avalonia.Imaging.PixelMan</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!--
    Local PixelMan builds (src/Imaging/PixelMan.Local) carry changes the feed package does not
    have yet; each symbol below switches the backend to one of them.
    PIXELMAN_HEADER_FACTS: PmImageInspection reports size, frame count and resolution.
  -->
  <PropertyGroup Condition="$(PixelManVersion.Contains('-local.'))">
    <DefineConstants>$(DefineConstants);PIXELMAN_HEADER_FACTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Avalonia.Base\Avalonia.Base.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.PixelMan" />
  </ItemGroup>

  <Import Project="..\..\..\build\Base.props" />
  <Import Project="..\..\..\build\NullableEnable.props" />
  <Import Project="..\..\..\build\TrimmingEnable.props" />
  <Import Project="..\..\..\build\DevAnalyzers.props" />

  <ItemGroup Label="InternalsVisibleTo">
    <InternalsVisibleTo Include="Avalonia.Imaging.PixelMan.Tests, PublicKey=$(AvaloniaPublicKey)" />
  </ItemGroup>
</Project>

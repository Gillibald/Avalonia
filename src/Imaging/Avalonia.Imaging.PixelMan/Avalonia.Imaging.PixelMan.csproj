<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The backend builds against a local PixelMan build (./build.sh PixelManLocal),
    restored from the folder NuGet.config next to this file names, so this project is not part
    of the solution yet.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(AvsCurrentTargetFramework);$(AvsLegacyTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Avalonia.Imaging.PixelMan</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- Restore needs the package the PixelManLocal build target packs. -->
  <Target Name="RequireLocalPixelMan" BeforeTargets="_LoadRestoreGraphEntryPoints;CollectPackageReferences" Condition="'$(PixelManVersion)' == ''">
    <Error Text="No local PixelMan build is selected. Run ./build.sh PixelManLocal (build.cmd on Windows) first; --pixelman &lt;checkout or git ref&gt; picks another PixelMan." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\..\Avalonia.Base\Avalonia.Base.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.PixelMan" />
  </ItemGroup>

  <Import Project="..\..\..\build\Base.props" />
  <Import Project="..\..\..\build\NullableEnable.props" />
  <Import Project="..\..\..\build\TrimmingEnable.props" />
  <Import Project="..\..\..\build\DevAnalyzers.props" />

  <ItemGroup Label="InternalsVisibleTo">
    <InternalsVisibleTo Include="Avalonia.Imaging.PixelMan.Tests, PublicKey=$(AvaloniaPublicKey)" />
  </ItemGroup>
</Project>

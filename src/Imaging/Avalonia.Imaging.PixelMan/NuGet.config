<?xml version="1.0" encoding="utf-8"?>
<!--
  PixelMan is published on the internal Avalonia feed only, so this project restores it
  from there; the repository's own sources stay untouched for every other project. The
  password comes from the INTERNAL_FEED_PASSWORD environment variable.
-->
<configuration>
  <packageSources>
    <add key="pixelman-internal" value="https://internal-nuget-feed.avaloniaui.net/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="pixelman-internal">
      <package pattern="Avalonia.PixelMan" />
      <package pattern="Avalonia.PixelMan.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <pixelman-internal>
      <add key="Username" value="general" />
      <add key="ClearTextPassword" value="%INTERNAL_FEED_PASSWORD%" />
    </pixelman-internal>
  </packageSourceCredentials>
</configuration>

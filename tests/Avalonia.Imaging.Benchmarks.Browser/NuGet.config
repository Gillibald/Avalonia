<?xml version="1.0" encoding="utf-8"?>
<!--
  PixelMan comes from a local build: the PixelManLocal build target (./build.sh PixelManLocal) packs it into the
  folder below. The repository's own sources stay untouched for every other project.
-->
<configuration>
  <packageSources>
    <add key="pixelman-local" value="../../src/Imaging/PixelMan.Local/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="pixelman-local">
      <package pattern="Avalonia.PixelMan" />
      <package pattern="Avalonia.PixelMan.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

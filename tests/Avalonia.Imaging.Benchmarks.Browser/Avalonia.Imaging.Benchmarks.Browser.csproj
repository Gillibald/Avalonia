<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    Browser host of the imaging benchmarks. Needs the .NET 10 browser workload (wasm-tools-net10
    under SDK 11): the PixelMan package links its Emscripten 3.1.56 archive into net10.0 apps.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmEnableSIMD>true</WasmEnableSIMD>
  </PropertyGroup>
  <Import Project="..\..\build\NullableEnable.props" />
  <ItemGroup>
    <ProjectReference Include="..\Avalonia.Imaging.Benchmarks.Core\Avalonia.Imaging.Benchmarks.Core.csproj" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<!-- Written for the tests: a product customization adding a named family from the product font directory. -->
<fonts-modification version="1">
    <family customizationType="new-named-family" name="product-sans">
        <font weight="400" style="normal">ProductSans-Regular.ttf</font>
    </family>
    <alias name="product-sans-alias" to="product-sans" />
</fonts-modification>

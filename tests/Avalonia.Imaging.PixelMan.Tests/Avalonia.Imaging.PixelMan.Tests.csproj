<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
  <!-- Restores PixelMan from the internal feed (NuGet.config next to this file); not part of the solution yet. -->
  <PropertyGroup>
    <TargetFramework>$(AvsCurrentTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <!-- The tests of local PixelMan changes run against local builds only; see the backend project. -->
  <PropertyGroup Condition="$(PixelManVersion.Contains('-local.'))">
    <DefineConstants>$(DefineConstants);PIXELMAN_FRAME_ALLOCATOR;PIXELMAN_DECODE_SCALE;PIXELMAN_GLOBAL_PALETTE;PIXELMAN_ICO_WEBP</DefineConstants>
  </PropertyGroup>
  <Import Project="..\..\build\UnitTests.NetCore.targets" />
  <Import Project="..\..\build\XUnit.props" />
  <Import Project="..\..\build\SharedVersion.props" />
  <Import Project="..\..\build\NullableEnable.props" />
  <ItemGroup>
    <!-- Written by PixelMan's test-files/thirdparty/synth/r5.py (MIT). -->
    <None Include="Assets\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Avalonia.Base\Avalonia.Base.csproj" />
    <ProjectReference Include="..\..\src\Imaging\Avalonia.Imaging.PixelMan\Avalonia.Imaging.PixelMan.csproj" />
    <ProjectReference Include="..\Avalonia.Imaging.TestKit\Avalonia.Imaging.TestKit.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="15.0">
  <!-- Restores the local PixelMan build (NuGet.config next to this file); not part of the solution yet. -->
  <PropertyGroup>
    <TargetFramework>$(AvsCurrentTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <!-- Restore needs the package the PixelManLocal build target packs. -->
  <Target Name="RequireLocalPixelMan" BeforeTargets="_LoadRestoreGraphEntryPoints;CollectPackageReferences" Condition="'$(PixelManVersion)' == ''">
    <Error Text="No local PixelMan build is selected. Run ./build.sh PixelManLocal (build.cmd on Windows) first; --pixelman &lt;checkout or git ref&gt; picks another PixelMan." />
  </Target>
  <Import Project="..\..\build\UnitTests.NetCore.targets" />
  <Import Project="..\..\build\XUnit.props" />
  <Import Project="..\..\build\SharedVersion.props" />
  <Import Project="..\..\build\NullableEnable.props" />
  <ItemGroup>
    <!-- Written by PixelMan's test-files/thirdparty/synth/r5.py (MIT). -->
    <None Include="Assets\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Avalonia.Base\Avalonia.Base.csproj" />
    <ProjectReference Include="..\..\src\Imaging\Avalonia.Imaging.PixelMan\Avalonia.Imaging.PixelMan.csproj" />
    <ProjectReference Include="..\Avalonia.Imaging.TestKit\Avalonia.Imaging.TestKit.csproj" />
  </ItemGroup>
</Project>
